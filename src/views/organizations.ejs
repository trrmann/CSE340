<%- include('partials/header') %>
<main class="content-split">
  <section class="intro-block">
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
  </section>

  <section class="card-grid">
    <%_ organizations.forEach(organization => { _%>
    <div class="card">
      <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" class="card-logo">
      <div class="card-body">
        <strong><%= organization.name %></strong>
        <p><%= organization.description %></p>
        <a href="mailto:<%= organization.contact_email %>" class="contact-link"><%= organization.contact_email %></a>
      </div>
    </div>
    <%_ }); _%>
  </section>
</main>
<%- include('partials/footer') %>
