<%- include('partials/header') %>
<main class="content-split">
  <section class="intro-block">
    <h1><%= project.title %></h1>
    <p>
      Sponsored by
      <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <p><a href="#" onclick="document.getElementById('delete-form-<%= project.project_id %>').submit(); return false;">Delete Project</a></p>
    <form id="delete-form-<%= project.project_id %>" action="/project/<%= project.project_id %>?_method=DELETE" method="POST" class="hiddenForm">
    </form>
  </section>
  <section class="projects-column">
    <div class="card">
      <p>
        <strong>Date:</strong> <%= project.project_date.toLocaleDateString('en-US', { weekday:
        'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
      </p>
      <p><strong>Location:</strong> <%= project.location %></p>
      <p><%= project.description %></p>
<%_ if (categories.length > 0) { _%>
<ul class="tag-list">
  <%_ categories.forEach(category => { _%>
  <li><a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a></li>
  <%_ }); _%>
</ul>
<%_ } _%>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
