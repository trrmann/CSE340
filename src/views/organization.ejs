<%- include('partials/header') %>
<main class="content-split">
  <section class="intro-block">
    <h1><%= organizationDetails.name %></h1>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" class="card-logo">
    <p><%= organizationDetails.description %></p>
  </section>
  <section class="projects-column">
    <h2>Service Projects</h2>
    <div class="card-grid vertical-stack">
      <%_ projects.forEach(project => { _%>
      <div class="card">
        <h3><%= project.project_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>: <%= project.title %></h3>
        <p><%= project.description %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
      </div>
      <%_ }); _%>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
